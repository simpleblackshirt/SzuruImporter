{
  "name": "szuru-importer",
  "displayName": "Szuru Importer",
  "description": "Import media from various sites into szurubooru.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:web": "vite",
    "dev:js": "run-p dev:js:*",
    "dev:js:content": "npm run build:js:content -- --mode development",
    "dev:js:background": "npm run build:js:background -- --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:js",
    "build:prepare": "esno scripts/prepare.ts",
    "build:web": "vite build",
    "build:js": "run-s build:js:*",
    "build:js:content": "vite build --config vite.config.content.ts",
    "build:js:background": "vite build --config vite.config.background.ts",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "rimraf extension.zip && jszip-cli add extension/* -o ./extension.zip",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "sign:firefox": "node node_modules/dotenv-cli/cli.js -e .env -- web-ext sign --source-dir ./extension",
    "clear": "rimraf --glob extension/dist extension/manifest.json extension.*",
    "lint": "eslint .",
    "extlint": "web-ext lint -s extension",
    "test": "vitest run",
    "pretty": "prettier -w ."
  },
  "dependencies": {
    "axios": "^1.20.0",
    "byte-size": "^9.0.1",
    "deepmerge": "^4.3.1",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.2",
    "neo-scraper": "file:..\\neo-scraper",
    "pinia": "^4.1.0",
    "primeflex": "^4.0.0",
    "primevue": "^5.0.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@ffflorian/jszip-cli": "^3.16.10",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@types/byte-size": "^8.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "esno": "^4.8.0",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.2",
    "kolorist": "^1.8.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "web-ext": "^10.7.0",
    "webextension-polyfill": "^0.12.0"
  }
}
